class Solution {
public:
    double median(vector<int> &arr1, vector<int> &arr2) {
        vector<int> ans;
        for(int x:arr1){
            ans.push_back(x);
        }
        for(int x:arr2){
            ans.push_back(x);
        }
        sort(ans.begin(),ans.end());
        int n=ans.size();
        if(n%2==1){
            return ans[n/2];
        }
        else{
            return (ans[n/2-1]+ans[n/2])/2.0;
        }
    }
};
