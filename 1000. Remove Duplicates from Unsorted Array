class Solution {
public:
    vector<int> removeDuplicates(vector<int>& arr) {
        vector<int> ans;
        for(int i=0;i<arr.size();i++){
            if(find(ans.begin(),ans.end(),arr[i])==ans.end()){
                ans.push_back(arr[i]);
                
            }
            
        }
        return ans;
    }
};
